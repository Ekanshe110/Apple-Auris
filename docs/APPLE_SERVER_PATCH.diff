+def _apple_recommendation_track(song: dict) -> dict:
+    """Normalize one Apple catalogue song without changing its exact id."""
+    attrs = song.get("attributes") or {}
+    art = str((attrs.get("artwork") or {}).get("url") or "")
+    if art:
+        art = ARTWORK_RE.sub("600x600", art)
+    traits = [str(item).lower() for item in (attrs.get("audioTraits") or [])]
+    duration_ms = attrs.get("durationInMillis")
+    content_rating = str(attrs.get("contentRating") or "").strip().lower()
+    song_id = str(song.get("id") or "")
+    if not song_id:
+        return {}
+    remember_track_atmos(song_id, any("atmos" in item for item in traits))
+    track = {
+        "id": song_id,
+        "title": attrs.get("name") or "",
+        "artist": attrs.get("artistName") or "",
+        "album": attrs.get("albumName") or "",
+        "duration": (duration_ms / 1000.0) if duration_ms else None,
+        "artworkURL": art or None,
+        "format": "m4a",
+        "audioQuality": (
+            "HI-RES LOSSLESS"
+            if any("hi-res" in item for item in traits)
+            else "LOSSLESS"
+            if any("lossless" in item for item in traits)
+            else "AAC"
+        ),
+        "audioMode": "DOLBY_ATMOS" if any("atmos" in item for item in traits) else "STEREO",
+        "atmos": any("atmos" in item for item in traits),
+        "contentRating": content_rating or None,
+        "explicit": content_rating == "explicit" if content_rating else None,
+        "isrc": str(attrs.get("isrc") or "").strip() or None,
+    }
+    remember_track_meta(track)
+    return track
+
+
+def _apple_recommendations(limit: int = 40) -> list[dict]:
+    """Apple Music's personalised recommendations as exact catalogue rows.
+
+    Apple exposes recommendation groups whose contents are mostly albums. The
+    album tracks are read from the public catalogue and keep their exact song
+    ids, ratings and ISRCs. Account tokens never leave the server.
+    """
+    try:
+        developer_token = get_developer_token()
+        music_token = (WRAPPER_DATA / "MUSIC_TOKEN").read_text("utf-8").strip()
+    except OSError as exc:
+        raise AppleLibraryApiError(
+            401, "signed_out", "Apple Music account is not connected"
+        ) from exc
+    if not developer_token or not music_token:
+        raise AppleLibraryApiError(
+            401, "signed_out", "Apple Music account is not connected"
+        )
+
+    user_headers = {
+        "Authorization": f"Bearer {developer_token}",
+        "Music-User-Token": music_token,
+        "Origin": "https://music.apple.com",
+        "Accept": "application/json",
+    }
+    catalog_headers = {
+        "Authorization": f"Bearer {developer_token}",
+        "Origin": "https://music.apple.com",
+        "Accept": "application/json",
+    }
+    try:
+        raw = _http_get(
+            "https://amp-api.music.apple.com/v1/me/recommendations?limit=8",
+            user_headers,
+            timeout=20,
+        )
+        payload = json.loads(raw.decode("utf-8"))
+    except urllib.error.HTTPError as exc:
+        if exc.code == 401:
+            raise AppleLibraryApiError(
+                401, "signed_out", "Apple Music sign-in required"
+            ) from exc
+        if exc.code == 429:
+            raise AppleLibraryApiError(
+                429, "rate_limited", "Apple Music recommendations are rate limited"
+            ) from exc
+        raise AppleLibraryApiError(
+            502, "apple_upstream_error", "Apple Music recommendations request failed"
+        ) from exc
+    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
+        raise AppleLibraryApiError(
+            502, "invalid_upstream_response", "Apple Music returned invalid recommendations"
+        ) from exc
+
+    album_ids: list[str] = []
+    direct_songs: list[dict] = []
+    for group in payload.get("data") or []:
+        contents = ((group.get("relationships") or {}).get("contents") or {}).get("data") or []
+        for item in contents:
+            item_type = str(item.get("type") or "")
+            item_id = str(item.get("id") or "")
+            if item_type == "albums" and item_id and item_id not in album_ids:
+                album_ids.append(item_id)
+            elif item_type == "songs":
+                direct_songs.append(item)
+
+    cfg = load_config()
+    storefront = (cfg.get("storefront") or "us").strip().lower()
+    if not STORE_RE.match(storefront):
+        storefront = "us"
+    songs = list(direct_songs)
+    for album_id in album_ids:
+        if len(songs) >= limit:
+            break
+        url = (
+            f"https://amp-api.music.apple.com/v1/catalog/{storefront}/albums/"
+            f"{urllib.parse.quote(album_id, safe='')}/tracks?limit=50"
+        )
+        try:
+            raw = _http_get(url, catalog_headers, timeout=15)
+            album = json.loads(raw.decode("utf-8"))
+        except (urllib.error.HTTPError, UnicodeDecodeError, json.JSONDecodeError):
+            continue
+        songs.extend(album.get("data") or [])
+
+    tracks: list[dict] = []
+    seen: set[str] = set()
+    for song in songs:
+        normalized = _apple_recommendation_track(song)
+        song_id = str(normalized.get("id") or "")
+        if not song_id or song_id in seen:
+            continue
+        seen.add(song_id)
+        tracks.append(normalized)
+        if len(tracks) >= limit:
+            break
+    return tracks
+
