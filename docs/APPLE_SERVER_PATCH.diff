+def _library_api_get(path: str, offset: int | None = None, limit: int | None = None) -> dict:
+    """Read one page from the linked slot's private Apple Music library.
+
+    The path token already selects the slot. The slot's developer and Music
+    user tokens stay on the server and are sent only as request headers.
+    """
+    try:
+        developer_token = get_developer_token()
+        music_token = (WRAPPER_DATA / "MUSIC_TOKEN").read_text("utf-8").strip()
+    except OSError as exc:
+        raise AppleLibraryApiError(
+            401, "signed_out", "Apple Music account is not connected"
+        ) from exc
+    if not developer_token or not music_token:
+        raise AppleLibraryApiError(
+            401, "signed_out", "Apple Music account is not connected"
+        )
+    query = {}
+    if offset is not None:
+        query["offset"] = str(int(offset))
+    if limit is not None:
+        query["limit"] = str(int(limit))
+    url = f"https://amp-api.music.apple.com/v1/me/library{path}"
+    if query:
+        url += "?" + urllib.parse.urlencode(query)
+    try:
+        raw = _http_get(
+            url,
+            {
+                "Authorization": f"Bearer {developer_token}",
+                "Music-User-Token": music_token,
+                "Origin": "https://music.apple.com",
+                "Accept": "application/json",
+            },
+            timeout=20,
+        )
+    except urllib.error.HTTPError as exc:
+        if exc.code == 401:
+            raise AppleLibraryApiError(
+                401, "signed_out", "Apple Music sign-in required"
+            ) from exc
+        if exc.code == 403:
+            raise AppleLibraryApiError(
+                403, "forbidden", "Apple Music account lacks library scope"
+            ) from exc
+        if exc.code == 404:
+            raise AppleLibraryApiError(
+                404, "not_found", "Apple Music library item was not found"
+            ) from exc
+        if exc.code == 429:
+            raise AppleLibraryApiError(
+                429, "rate_limited", "Apple Music library is rate limited"
+            ) from exc
+        raise AppleLibraryApiError(
+            502, "apple_upstream_error", "Apple Music library request failed"
+        ) from exc
+    try:
+        data = json.loads(raw.decode("utf-8"))
+    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
+        raise AppleLibraryApiError(
+            502, "invalid_upstream_response", "Apple Music returned an invalid library response"
+        ) from exc
+    if not isinstance(data, dict):
+        raise AppleLibraryApiError(
+            502, "invalid_upstream_response", "Apple Music returned an invalid library response"
+        )
+    return data
+
