+def _cached_library_page(path: str, offset: int | None, limit: int | None) -> dict:
+    """Read one library page, caching successful upstream answers briefly."""
+    key = _library_page_cache_key(path, offset, limit)
+    now = time.time()
+    with _library_page_cache_lock:
+        entry = _library_page_cache.get(key)
+        if entry is not None and now - entry[0] < _LIBRARY_PAGE_CACHE_TTL:
+            return entry[1]
+    raw = _library_api_get(path, offset, limit)
+    with _library_page_cache_lock:
+        _library_page_cache[key] = (now, raw)
+    return raw
