+def _apple_home(limit: int = 20) -> list[dict]:
+    """Apple Music's personalised recommendations as structured shelves.
+
+    Preserves Apple's own recommendation groups: each shelf keeps the group's
+    title, subtitle and artwork, and items are returned as songs, albums or
+    playlists with exact catalogue ids. Albums are *not* expanded into tracks
+    here; the app loads tracks only when the listener opens the album page.
+    """
+    try:
+        developer_token = get_developer_token()
+        music_token = (WRAPPER_DATA / "MUSIC_TOKEN").read_text("utf-8").strip()
+    except OSError as exc:
+        raise AppleLibraryApiError(
+            401, "signed_out", "Apple Music account is not connected"
+        ) from exc
+    if not developer_token or not music_token:
+        raise AppleLibraryApiError(
+            401, "signed_out", "Apple Music account is not connected"
+        )
+
+    user_headers = {
+        "Authorization": f"Bearer {developer_token}",
+        "Music-User-Token": music_token,
+        "Origin": "https://music.apple.com",
+        "Accept": "application/json",
+    }
+    try:
+        raw = _http_get(
+            "https://amp-api.music.apple.com/v1/me/recommendations?limit=10",
+            user_headers,
+            timeout=20,
+        )
+        payload = json.loads(raw.decode("utf-8"))
+    except urllib.error.HTTPError as exc:
+        if exc.code == 401:
+            raise AppleLibraryApiError(
+                401, "signed_out", "Apple Music sign-in required"
+            ) from exc
+        if exc.code == 429:
+            raise AppleLibraryApiError(
+                429, "rate_limited", "Apple Music recommendations are rate limited"
+            ) from exc
+        raise AppleLibraryApiError(
+            502, "apple_upstream_error", "Apple Music recommendations request failed"
+        ) from exc
+    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
+        raise AppleLibraryApiError(
+            502, "invalid_upstream_response", "Apple Music returned invalid recommendations"
+        ) from exc
+
+    shelves: list[dict] = []
+    seen_shelves: set[str] = set()
+    for group in payload.get("data") or []:
+        attrs = group.get("attributes") or {}
+        title = str(attrs.get("title") or "").strip()
+        if not title:
+            continue
+        key = title.lower()
+        if key in seen_shelves:
+            continue
+        seen_shelves.add(key)
+        art = str((attrs.get("artwork") or {}).get("url") or "")
+        if art:
+            art = ARTWORK_RE.sub("600x600", art)
+        contents = ((group.get("relationships") or {}).get("contents") or {}).get("data") or []
+        items: list[dict] = []
+        for item in contents:
+            item_type = str(item.get("type") or "")
+            item_id = str(item.get("id") or "")
+            if not item_id:
+                continue
+            item_attrs = item.get("attributes") or {}
+            item_art = str((item_attrs.get("artwork") or {}).get("url") or "")
+            if item_art:
+                item_art = ARTWORK_RE.sub("600x600", item_art)
+            if item_type == "songs":
+                norm = _apple_recommendation_track(item)
+                if norm.get("id"):
+                    norm["type"] = "song"
+                    items.append(norm)
+            elif item_type == "albums":
+                items.append({
+                    "type": "album",
+                    "id": item_id,
+                    "title": str(item_attrs.get("name") or ""),
+                    "artist": str(item_attrs.get("artistName") or ""),
+                    "artworkURL": item_art or None,
+                })
+            elif item_type == "playlists":
+                items.append({
+                    "type": "playlist",
+                    "id": item_id,
+                    "title": str(item_attrs.get("name") or ""),
+                    "artist": str(item_attrs.get("curatorName") or ""),
+                    "artworkURL": item_art or None,
+                })
+        if not items:
+            continue
+        shelves.append({
+            "title": title,
+            "subtitle": str(attrs.get("subtitle") or attrs.get("description") or "").strip(),
+            "artworkURL": art or None,
+            "items": items,
+        })
+        if len(shelves) >= limit:
+            break
+    return shelves
+
