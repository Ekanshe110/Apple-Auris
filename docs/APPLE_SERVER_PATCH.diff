+def _library_item(raw: dict) -> dict:
+    attrs = raw.get("attributes") or {}
+    play_params = attrs.get("playParams") or {}
+    raw_id = str(raw.get("id") or "")
+    catalog_id = str(play_params.get("catalogId") or "")
+    if not catalog_id and SONG_RE.fullmatch(raw_id):
+        catalog_id = raw_id
+    artwork = str((attrs.get("artwork") or {}).get("url") or "")
+    if artwork:
+        artwork = ARTWORK_RE.sub("600x600", artwork)
+    duration_ms = attrs.get("durationInMillis")
+    content_rating = str(attrs.get("contentRating") or "").strip().lower()
+    return {
+        "id": raw_id,
+        "catalogId": catalog_id,
+        "streamId": catalog_id if str(raw.get("type") or "").startswith("library-songs") else "",
+        "title": str(attrs.get("name") or ""),
+        "artist": str(attrs.get("artistName") or ""),
+        "album": str(attrs.get("albumName") or ""),
+        "artworkURL": artwork,
+        "duration": (float(duration_ms) / 1000.0) if duration_ms else None,
+        "contentRating": content_rating or None,
+        "explicit": content_rating == "explicit" if content_rating else None,
+        "isrc": str(attrs.get("isrc") or "").strip() or None,
+    }
+
+
+def _library_page(raw: dict, offset: int, limit: int) -> dict:
+    rows = raw.get("data") or []
+    if not isinstance(rows, list):
+        rows = []
+    items = [_library_item(row) for row in rows if isinstance(row, dict)]
+    meta = raw.get("meta") or {}
+    total_value = meta.get("total") if isinstance(meta, dict) else None
+    total = int(total_value) if isinstance(total_value, (int, float)) else None
+    has_more = bool(raw.get("next"))
+    if total is not None:
+        has_more = has_more or (offset + len(items) < total)
+    return {
+        "items": items,
+        "offset": offset,
+        "limit": limit,
+        "total": total,
+        "hasMore": has_more,
+        "nextOffset": (offset + len(items)) if has_more and items else None,
+    }
+
+
+def _library_page_params(query: dict) -> tuple[int, int]:
+    try:
+        offset = int((query.get("offset") or ["0"])[0])
+        limit = int((query.get("limit") or ["25"])[0])
+    except (TypeError, ValueError) as exc:
+        raise AppleLibraryApiError(
+            400, "invalid_request", "offset and limit must be integers"
+        ) from exc
+    if offset < 0:
+        raise AppleLibraryApiError(
+            400, "invalid_request", "offset must be non-negative"
+        )
+    if limit < 1 or limit > 100:
+        raise AppleLibraryApiError(
+            400, "invalid_request", "limit must be from 1 to 100"
+        )
+    return offset, limit
+
