+def _library_api_get(path: str, offset: int | None = None, limit: int | None = None) -> dict:
+    """Read one page from the linked slot's private Apple Music library.
+
+    The path token already selects the slot. The slot's developer and Music
+    user tokens stay on the server and are sent only as request headers.
+    """
+    try:
+        developer_token = get_developer_token()
+        music_token = (WRAPPER_DATA / "MUSIC_TOKEN").read_text("utf-8").strip()
+    except OSError as exc:
+        raise AppleLibraryApiError(
+            401, "signed_out", "Apple Music account is not connected"
+        ) from exc
+    if not developer_token or not music_token:
+        raise AppleLibraryApiError(
+            401, "signed_out", "Apple Music account is not connected"
+        )
+    query = {}
+    if offset is not None:
+        query["offset"] = str(int(offset))
+    if limit is not None:
+        query["limit"] = str(int(limit))
+    url = f"https://amp-api.music.apple.com/v1/me/library{path}"
+    if query:
+        url += "?" + urllib.parse.urlencode(query)
+    try:
+        raw = _http_get(
+            url,
+            {
+                "Authorization": f"Bearer {developer_token}",
+                "Music-User-Token": music_token,
+                "Origin": "https://music.apple.com",
+                "Accept": "application/json",
+            },
+            timeout=20,
+        )
+    except urllib.error.HTTPError as exc:
+        if exc.code == 401:
+            raise AppleLibraryApiError(
+                401, "signed_out", "Apple Music sign-in required"
+            ) from exc
+        if exc.code == 403:
+            raise AppleLibraryApiError(
+                403, "forbidden", "Apple Music account lacks library scope"
+            ) from exc
+        if exc.code == 404:
+            raise AppleLibraryApiError(
+                404, "not_found", "Apple Music library item was not found"
+            ) from exc
+        if exc.code == 429:
+            raise AppleLibraryApiError(
+                429, "rate_limited", "Apple Music library is rate limited"
+            ) from exc
+        raise AppleLibraryApiError(
+            502, "apple_upstream_error", "Apple Music library request failed"
+        ) from exc
+    try:
+        data = json.loads(raw.decode("utf-8"))
+    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
+        raise AppleLibraryApiError(
+            502, "invalid_upstream_response", "Apple Music returned an invalid library response"
+        ) from exc
+    if not isinstance(data, dict):
+        raise AppleLibraryApiError(
+            502, "invalid_upstream_response", "Apple Music returned an invalid library response"
+        )
+    return data
+
+
+def _library_item(raw: dict) -> dict:
+    attrs = raw.get("attributes") or {}
+    play_params = attrs.get("playParams") or {}
+    raw_id = str(raw.get("id") or "")
+    catalog_id = str(play_params.get("catalogId") or "")
+    if not catalog_id and SONG_RE.fullmatch(raw_id):
+        catalog_id = raw_id
+    artwork = str((attrs.get("artwork") or {}).get("url") or "")
+    if artwork:
+        artwork = ARTWORK_RE.sub("600x600", artwork)
+    duration_ms = attrs.get("durationInMillis")
+    content_rating = str(attrs.get("contentRating") or "").strip().lower()
+    return {
+        "id": raw_id,
+        "catalogId": catalog_id,
+        "streamId": catalog_id if str(raw.get("type") or "").startswith("library-songs") else "",
+        "title": str(attrs.get("name") or ""),
+        "artist": str(attrs.get("artistName") or ""),
+        "album": str(attrs.get("albumName") or ""),
+        "artworkURL": artwork,
+        "duration": (float(duration_ms) / 1000.0) if duration_ms else None,
+        "contentRating": content_rating or None,
+        "explicit": content_rating == "explicit" if content_rating else None,
+        "isrc": str(attrs.get("isrc") or "").strip() or None,
+    }
+
+
+def _library_page(raw: dict, offset: int, limit: int) -> dict:
+    rows = raw.get("data") or []
+    if not isinstance(rows, list):
+        rows = []
+    items = [_library_item(row) for row in rows if isinstance(row, dict)]
+    meta = raw.get("meta") or {}
+    total_value = meta.get("total") if isinstance(meta, dict) else None
+    total = int(total_value) if isinstance(total_value, (int, float)) else None
+    has_more = bool(raw.get("next"))
+    if total is not None:
+        has_more = has_more or (offset + len(items) < total)
+    return {
+        "items": items,
+        "offset": offset,
+        "limit": limit,
+        "total": total,
+        "hasMore": has_more,
+        "nextOffset": (offset + len(items)) if has_more and items else None,
+    }
+
+
+def _library_page_params(query: dict) -> tuple[int, int]:
+    try:
+        offset = int((query.get("offset") or ["0"])[0])
+        limit = int((query.get("limit") or ["25"])[0])
+    except (TypeError, ValueError) as exc:
+        raise AppleLibraryApiError(
+            400, "invalid_request", "offset and limit must be integers"
+        ) from exc
+    if offset < 0:
+        raise AppleLibraryApiError(
+            400, "invalid_request", "offset must be non-negative"
+        )
+    if limit < 1 or limit > 100:
+        raise AppleLibraryApiError(
+            400, "invalid_request", "limit must be from 1 to 100"
+        )
+    return offset, limit
+
+
+def _apple_write_headers() -> dict:
+    """Headers for Apple Music write endpoints."""
+    developer_token = get_developer_token()
+    music_token = (WRAPPER_DATA / "MUSIC_TOKEN").read_text("utf-8").strip()
+    if not developer_token or not music_token:
+        raise AppleLibraryApiError(
+            401, "signed_out", "Apple Music account is not connected"
+        )
+    return {
+        "Authorization": f"Bearer {developer_token}",
+        "Music-User-Token": music_token,
+        "Origin": "https://music.apple.com",
+        "Accept": "application/json",
+        "Content-Type": "application/json",
+    }
+
