+def _refresh_worker_sources(slot_dir: Path) -> None:
+    """Refresh deployable worker code without touching per-slot state.
+
+    Runtime directories contain credentials, wrapper data, sessions, logs and
+    cached media, so they must never be replaced wholesale.  The small set of
+    deployable files is refreshed whenever a worker starts, before the new
+    process is launched; an idle worker therefore picks up a deployment on its
+    next start and an active worker is never mutated underneath itself.
+    """
+    for name in ("app.py", "fastpath.py", "atmos_fastpath.py", "manifest.json"):
+        src = SOURCE / name
+        if not src.is_file():
+            continue
+        dst = slot_dir / name
+        try:
+            if dst.is_file() and dst.read_bytes() == src.read_bytes():
+                continue
+        except OSError:
+            pass
+        tmp = slot_dir / f".{name}.new"
+        shutil.copy2(src, tmp)
+        os.replace(tmp, dst)
+
