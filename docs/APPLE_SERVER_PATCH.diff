+def _apple_catalog_tracks(collection: str, collection_id: str, limit: int = 100) -> list[dict]:
+    """Tracks of a public Apple Music album or playlist.
+
+    The result is normalised to the same track shape used by recommendations
+    and search so the addon contract stays consistent.
+    """
+    if collection not in ("albums", "playlists"):
+        raise AppleLibraryApiError(400, "invalid_request", "collection must be albums or playlists")
+    if not APPLE_ID_RE.fullmatch(collection_id):
+        raise AppleLibraryApiError(400, "invalid_request", "invalid collection id")
+    developer_token = get_developer_token()
+    if not developer_token:
+        raise AppleLibraryApiError(401, "signed_out", "Apple Music developer token is not available")
+    headers = {
+        "Authorization": f"Bearer {developer_token}",
+        "Origin": "https://music.apple.com",
+        "Accept": "application/json",
+    }
+    storefront = _storefront()
+    encoded = urllib.parse.quote(collection_id, safe="")
+    url = (
+        f"https://amp-api.music.apple.com/v1/catalog/{storefront}/"
+        f"{collection}/{encoded}/tracks?limit={max(1, min(100, limit))}"
+    )
+    try:
+        raw = _http_get(url, headers, timeout=15)
+        payload = json.loads(raw.decode("utf-8"))
+    except urllib.error.HTTPError as exc:
+        if exc.code == 404:
+            raise AppleLibraryApiError(404, "not_found", f"Apple Music {collection} not found") from exc
+        if exc.code == 429:
+            raise AppleLibraryApiError(429, "rate_limited", f"Apple Music {collection} rate limited") from exc
+        raise AppleLibraryApiError(502, "apple_upstream_error", f"Apple Music {collection} request failed") from exc
+    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
+        raise AppleLibraryApiError(502, "invalid_upstream_response", f"Apple Music returned invalid {collection}") from exc
+
+    tracks: list[dict] = []
+    for song in payload.get("data") or []:
+        norm = _apple_recommendation_track(song)
+        if norm.get("id"):
+            tracks.append(norm)
+    return tracks
+
+
+class AppleLibraryApiError(Exception):
+    """An Apple library request failed with a status the client must see."""
+
+    def __init__(self, status: int, code: str, message: str):
+        super().__init__(message)
+        self.status = status
+        self.code = code
+        self.message = message
+
