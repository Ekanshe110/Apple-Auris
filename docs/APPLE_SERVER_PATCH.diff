+def _apple_rate(song_id: str, liked: bool) -> None:
+    """Set or clear the Apple Music 'love' rating for a song."""
+    headers = _apple_write_headers()
+    encoded = urllib.parse.quote(song_id, safe="")
+    url = f"https://amp-api.music.apple.com/v1/me/ratings/songs/{encoded}"
+    try:
+        if liked:
+            body = json.dumps({"value": 1}).encode("utf-8")
+            req = urllib.request.Request(url, data=body, headers=headers, method="PUT")
+        else:
+            req = urllib.request.Request(url, headers=headers, method="DELETE")
+        urllib.request.urlopen(req, timeout=20)
+    except urllib.error.HTTPError as exc:
+        if exc.code in (401, 403):
+            raise AppleLibraryApiError(
+                exc.code, "forbidden", "Apple Music account lacks rating scope"
+            ) from exc
+        if exc.code == 404:
+            raise AppleLibraryApiError(
+                404, "not_found", "Song was not found in Apple Music"
+            ) from exc
+        if exc.code == 429:
+            raise AppleLibraryApiError(
+                429, "rate_limited", "Apple Music rate limited the rating"
+            ) from exc
+        raise AppleLibraryApiError(
+            502, "apple_upstream_error", f"Apple Music rating failed: {exc.code}"
+        ) from exc
+    except Exception as exc:
+        raise AppleLibraryApiError(
+            502, "apple_upstream_error", "Apple Music rating failed"
+        ) from exc
+
