+@app.get("/a/{config_token}/library/{collection}")
+async def addon_library_collection(
+    config_token: str,
+    collection: str,
+    offset: int = 0,
+    limit: int = 25,
+) -> Response:
+    if collection not in ("playlists", "albums", "songs"):
+        return _library_error_response(
+            _AppleLibraryHTTPError(404, "not_found", "Apple Music library route was not found")
+        )
+    account_id = _verify_config(config_token)
+    await _require_subscription(account_id)
+    try:
+        page_offset, page_limit = _library_page_params(offset, limit)
+        record = _record(account_id)
+        page = await run_in_threadpool(
+            _normalize_library_page,
+            _library_api_get(record, f"/{collection}", page_offset, page_limit),
+            page_offset,
+            page_limit,
+        )
+        return _library_json_response(page)
+    except _AppleLibraryHTTPError as exc:
+        return _library_error_response(exc)
+
