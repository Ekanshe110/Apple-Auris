+def _apple_recommendation_track(song: dict) -> dict:
+    """Normalize one Apple catalogue song without changing its exact id."""
+    attrs = song.get("attributes") or {}
+    art = str((attrs.get("artwork") or {}).get("url") or "")
+    if art:
+        art = ARTWORK_RE.sub("600x600", art)
+    traits = [str(item).lower() for item in (attrs.get("audioTraits") or [])]
+    duration_ms = attrs.get("durationInMillis")
+    content_rating = str(attrs.get("contentRating") or "").strip().lower()
+    song_id = str(song.get("id") or "")
+    if not song_id:
+        return {}
+    remember_track_atmos(song_id, any("atmos" in item for item in traits))
+    track = {
+        "id": song_id,
+        "title": attrs.get("name") or "",
+        "artist": attrs.get("artistName") or "",
+        "album": attrs.get("albumName") or "",
+        "duration": (duration_ms / 1000.0) if duration_ms else None,
+        "artworkURL": art or None,
+        "format": "m4a",
+        "audioQuality": (
+            "HI-RES LOSSLESS"
+            if any("hi-res" in item for item in traits)
+            else "LOSSLESS"
+            if any("lossless" in item for item in traits)
+            else "AAC"
+        ),
+        "audioMode": "DOLBY_ATMOS" if any("atmos" in item for item in traits) else "STEREO",
+        "atmos": any("atmos" in item for item in traits),
+        "contentRating": content_rating or None,
+        "explicit": content_rating == "explicit" if content_rating else None,
+        "isrc": str(attrs.get("isrc") or "").strip() or None,
+    }
+    remember_track_meta(track)
+    return track
+
