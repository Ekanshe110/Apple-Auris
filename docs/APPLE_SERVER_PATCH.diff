+def _apple_add_to_playlist(playlist_id: str, song_ids: list[str]) -> dict:
+    """Add one or more catalog songs to a library playlist."""
+    headers = _apple_write_headers()
+    encoded = urllib.parse.quote(playlist_id, safe="")
+    url = (
+        f"https://amp-api.music.apple.com/v1/me/library/playlists/"
+        f"{encoded}/tracks"
+    )
+    body = json.dumps(
+        {"data": [{"id": sid, "type": "songs"} for sid in song_ids]}
+    ).encode("utf-8")
+    req = urllib.request.Request(url, data=body, headers=headers, method="POST")
+    try:
+        urllib.request.urlopen(req, timeout=20)
+        return {"added": len(song_ids)}
+    except urllib.error.HTTPError as exc:
+        if exc.code in (401, 403):
+            raise AppleLibraryApiError(
+                exc.code, "forbidden", "Apple Music account lacks playlist write scope"
+            ) from exc
+        if exc.code == 404:
+            raise AppleLibraryApiError(
+                404, "not_found", "Playlist or song was not found"
+            ) from exc
+        if exc.code == 429:
+            raise AppleLibraryApiError(
+                429, "rate_limited", "Apple Music rate limited the playlist write"
+            ) from exc
+        raise AppleLibraryApiError(
+            502, "apple_upstream_error", f"Apple Music playlist write failed: {exc.code}"
+        ) from exc
+    except Exception as exc:
+        raise AppleLibraryApiError(
+            502, "apple_upstream_error", "Apple Music playlist write failed"
+        ) from exc
